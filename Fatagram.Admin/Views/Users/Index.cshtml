@using Fatagram.Application.Dtos.Account;
@model AccountsDto

@{
    ViewBag.Title = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="users">
    <h1 class="users-title">Accounts and Users Manager</h1>

    <div class="features">
        <form class="users-features" action="@Url.Action("GenerateUsers")" method="post">
            <input type="number" name="userCount" id="numberOfUsers" class="users-buttons__input"
                placeholder="Number of users" />
            <button type="submit" class="users-buttons__btn">
                Generate
            </button>
        </form>

        <form class="users-features" action="@Url.Action("AutoSendFriendRequest")" method="post">
            <button type="submit" class="users-buttons__btn">
                Spam Friend Request
            </button>
            <input type="text" name="targetId" id="numberOfUsers" class="users-buttons__input"
                placeholder="Target ID" />
        </form>
    </div>


    <table class="users-table">
        <thead class="users-table__head">
            <tr class="users-table__head-row">
                <th>ID</th>
                <th>Username</th>
                <th>Full name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody class="users-table__body">
            @foreach (var account in Model.Accounts)
            {
                <tr class="users-table__body-row">
                    <td>@account.Id</td>
                    <td>@account.Username</td>
                    <td>@account.User.FullName</td>
                    <td>
                        <button class="users-table__btn">Edit</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="users-pagination">
        @if (ViewBag.Page > 1)
        {
            <a href="@Url.Action("Index", new { page = ViewBag.Page - 1 })" class="users-pagination__btn">Previous</a>
        }
        <span class="users-pagination__info">@ViewBag.Page of @Model.TotalPage</span>
        @if (ViewBag.Page < Model.TotalPage)
        {
            <a href="@Url.Action("Index", new { page = ViewBag.Page + 1 })" class="users-pagination__btn">Next</a>
        }
    </div>
</div>